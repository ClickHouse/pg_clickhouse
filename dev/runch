#!/bin/sh

# Start and stop various versions of ClickHouse. Requires:
#
# *   `clickhousectl` (a.k.a., `chctl`) v0.3.0 or later

set -e

usage() {
    cat <<EOF
Usage: runch <command> [<args>]

The runch commands are:
    start [<version>]   Start ClickHouse version; defaults to 26.6
    stop                Stop the current ClickHouse server
    status              Show status of all running severs
    remove <version>    Remove a version
    versions            Show currently-installed versions
    help                Show this usage statement and command summary
EOF
}

dir="$(CDPATH='' cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)"
name="$(basename "$0")"

cfg_file() {
    fn=default
    major="${1%%.*}"
    case "${1##*.}" in
        ''|*[!0-9]*) ;;
        *)
            if [ "$major" != "$1" ] && [ "$major" -lt 25 ]; then
                # Enable JSON before 25.0. ClickHouse renamed its setting in 24.8.
                case "$1" in
                    24.8*) fn=allow_json ;;
                    *) fn=allow_object ;;
                esac
            fi
            ;;
    esac

    mkdir -p "$HOME/.clickhouse/configs"
    cp "$dir/configs/$fn.yaml" "$HOME/.clickhouse/configs/runch-$fn.yaml"
    echo "runch-$fn"
}

lake_pid="${TMPDIR:-/tmp}/runch-lake.pid"
lake_log="${TMPDIR:-/tmp}/runch-lake.log"

stop_lake() {
    if [ -f "$lake_pid" ]; then
        kill "$(cat "$lake_pid")" 2> /dev/null || true
        rm -f "$lake_pid"
    fi
}

# Seed an Iceberg warehouse under server user_files, then serve its REST
# catalog on port 8181 for test/sql/import_lake.sql
start_lake() {
    data="$(chctl local client "$1" -q "SELECT path FROM system.disks WHERE name = 'default'")"
    bin="$HOME/.clickhouse/versions/$(chctl local client "$1" -q 'SELECT version()')"
    warehouse="${data:?}user_files/pg_clickhouse_lake"
    rm -rf "$warehouse"
    # seed.sh exits 77 when ClickHouse is too old
    PATH="$bin:$PATH" sh "$dir/../test/lake/seed.sh" "$warehouse" || return $(($? != 77))

    printf 'Starting Iceberg catalog\n'
    nohup python3 -I "$dir/../test/lake/catalog.py" 8181 "$warehouse" > "$lake_log" 2>&1 < /dev/null &
    echo $! > "$lake_pid"
    if ! curl -sf --retry 10 --retry-connrefused --retry-delay 1 -o /dev/null http://127.0.0.1:8181/v1/config; then
        cat "$lake_log"
        return 1
    fi
}

case "$1" in
    stop)
        chctl local server stop-all # stop "$name"
        stop_lake
        ;;
    start)
        version="${2:-26.6}"

        chctl local server stop-all # stop "$name"
        stop_lake
        chctl local server start --name "$name-$version" --version "$version" --config-file "$(cfg_file "$version")"
        start_lake "$name-$version"
        ;;
    status)
        chctl local server list
        ;;
    versions)
        chctl local list
        ;;
    remove)
        version="$2"
        if [ -z "$version" ]; then
            printf 'No version specified\n'
            usage
            exit 1;
        fi
        chctl local remove "$version"
        ;;
    help)
        usage
        ;;
    *)
        test -n "$1" && printf 'Unknown command:  %s\n\n' "$1"
        usage
        exit 1;
        ;;
esac
