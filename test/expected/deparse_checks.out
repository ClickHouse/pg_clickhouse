               Remote SQL: SELECT id, grp, s, ts, n, arr FROM deparse_test.t2
(16 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT * FROM t1 LEFT JOIN (SELECT id, coalesce(n, 0) AS x FROM t2) ss ON t1.a = ss.id
JOIN t2 t3 ON t3.id = t1.a;
                                                                               QUERY PLAN                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Merge Left Join
   Output: t1.a, t1.b, t2.id, (COALESCE(t2.n, 0)), t3.id, t3.grp, t3.s, t3.ts, t3.n, t3.arr
   Merge Cond: (t1.a = t2.id)
   ->  Sort
         Output: t1.a, t1.b, t3.id, t3.grp, t3.s, t3.ts, t3.n, t3.arr
         Sort Key: t1.a
         ->  Foreign Scan
               Output: t1.a, t1.b, t3.id, t3.grp, t3.s, t3.ts, t3.n, t3.arr
               Relations: (t1) INNER JOIN (t2 t3)
               Remote SQL: SELECT r1.a, r1.b, r4.id, r4.grp, r4.s, r4.ts, r4.n, r4.arr FROM  deparse_test.t1 r1 ALL INNER JOIN deparse_test.t2 r4 ON (((r1.a = r4.id)))
   ->  Sort
         Output: t2.id, (COALESCE(t2.n, 0))
         Sort Key: t2.id
         ->  Foreign Scan on deparse_test.t2
               Output: t2.id, COALESCE(t2.n, 0)
               Remote SQL: SELECT id, n FROM deparse_test.t2
(16 rows)

