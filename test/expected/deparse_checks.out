(4 rows)

-- Aggregates: CollapsingMergeTree sign weighting, ordered-set
EXPLAIN (VERBOSE, COSTS OFF)
SELECT sum(v), avg(v) FILTER (WHERE v > 0), avg(v), count(v) FROM t3;
                                                                                                QUERY PLAN                                                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: (sum(v)), (avg(v) FILTER (WHERE (v > 0))), (avg(v)), (count(v))
   Relations: Aggregate on (t3)
   Remote SQL: SELECT sum(v * sign), sumIf(v * sign,(((v > 0)) > 0)) / sumIf(sign,(v > 0) AND v IS NOT NULL), sum(v * sign) / sumIf(sign,v IS NOT NULL), sumIf(sign,(v) IS NOT NULL) FROM deparse_test.t3
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY grp),
       percentile_disc(ARRAY[0.25, 0.75]) WITHIN GROUP (ORDER BY grp)
FROM t2;
                                                                                        QUERY PLAN                                                                                        
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: (percentile_cont('0.5'::double precision) WITHIN GROUP (ORDER BY ((grp)::double precision))), (percentile_disc('{0.25,0.75}'::double precision[]) WITHIN GROUP (ORDER BY grp))
   Relations: Aggregate on (t2)
   Remote SQL: SELECT quantile(0.5)(grp), quantilesExactLow(0.25,0.75)(grp) FROM deparse_test.t2
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT rank(1, 'x') WITHIN GROUP (ORDER BY grp, s) FROM t2;
                         QUERY PLAN                          
-------------------------------------------------------------
 Aggregate
   Output: rank(1, 'x'::text) WITHIN GROUP (ORDER BY grp, s)
   ->  Foreign Scan on deparse_test.t2
         Output: id, grp, s, ts, n, arr
         Remote SQL: SELECT grp, s FROM deparse_test.t2
(5 rows)

