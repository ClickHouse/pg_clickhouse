-- Scan and join between catalog tables push down
EXPLAIN (VERBOSE, COSTS OFF)
SELECT e.id, e.name, d.label
  FROM lake_bin."analytics.events" e
  JOIN lake_bin."analytics.sub.deep" d ON d.id = e.id
 WHERE e.score >= 0
 ORDER BY e.id;
                                                                                                    QUERY PLAN                                                                                                     
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: e.id, e.name, d.label
   Relations: ("analytics.events" e) INNER JOIN ("analytics.sub.deep" d)
   Remote SQL: SELECT r1.id, r1.name, r2.label FROM  lake_test."analytics.events" r1 ALL INNER JOIN lake_test."analytics.sub.deep" r2 ON (((r1.id = r2.id))) WHERE ((r1.score >= 0)) ORDER BY r2.id ASC NULLS LAST
(4 rows)

SELECT e.id, e.name, d.label
  FROM lake_bin."analytics.events" e
  JOIN lake_bin."analytics.sub.deep" d ON d.id = e.id
 WHERE e.score >= 0
 ORDER BY e.id;
 id | name  | label 
----+-------+-------
  1 | click | one
  3 | view  | three
(2 rows)

-- Unquoted name parses as schema-qualified and matches nothing
IMPORT FOREIGN SCHEMA lake_test LIMIT TO (analytics.events)
    FROM SERVER lake_bin INTO lake_limit;
\det lake_limit.*
 List of foreign tables
 Schema | Table | Server 
--------+-------+--------
(0 rows)

-- LIMIT TO and EXCEPT match quoted names
IMPORT FOREIGN SCHEMA lake_test LIMIT TO ("analytics.events")
    FROM SERVER lake_bin INTO lake_limit;
NOTICE:  pg_clickhouse: ClickHouse <Map> type was translated to <TEXT[][]> type for column "attrs"; please create composite type and alter the column if needed
NOTICE:  pg_clickhouse: ClickHouse <Tuple> type was translated to <TEXT[]> type for column "point"; please create composite type and alter the column if needed
