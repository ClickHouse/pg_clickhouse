CREATE SERVER operators_loopback FOREIGN DATA WRAPPER clickhouse_fdw OPTIONS(dbname 'operators_test', driver 'binary');
CREATE USER MAPPING FOR CURRENT_USER SERVER operators_loopback;
CREATE SERVER operators_admin FOREIGN DATA WRAPPER clickhouse_fdw;
CREATE USER MAPPING FOR CURRENT_USER SERVER operators_admin;
CALL clickhouse_perform('operators_admin', 'DROP DATABASE IF EXISTS operators_test');
CALL clickhouse_perform('operators_admin', 'CREATE DATABASE operators_test');
CALL clickhouse_perform('operators_admin', $$
    CREATE TABLE operators_test.nums (
        id  Int32,
        u8  UInt8,
        i16 Int16,
        i32 Int32,
        i64 Int64,
        f32 Float32,
        f64 Float64,
        n   Decimal(10, 2),
        ip  IPv4,
        ip6 IPv6,
        bin String,
        uid UUID
    ) ENGINE = MergeTree ORDER BY id
$$);
CALL clickhouse_perform('operators_admin', $$
    INSERT INTO operators_test.nums VALUES
        (1, 200, -3, -7, 9007199254740993, 0.1, 8, -1.5, '10.0.0.1', '::1', unhex('01'),
         '00000000-0000-0001-0000-000000000000'),
        (2, 5, 16384, 1, -8, 0.3, 4, 2.5, '10.0.0.2', '2001:db8::1', '',
         '00000000-0000-0000-0000-000000000001')
$$);
CREATE FOREIGN TABLE nums (
    id  int,
    u8  smallint,
    i16 smallint,
    i32 int,
    i64 bigint,
    f32 real,
    f64 float8,
    n   numeric(10, 2),
    ip  inet,
    ip6 inet,
    bin bytea,
    uid uuid
) SERVER operators_loopback;
-- Cast integer arguments to PostgreSQL types, as ClickHouse keeps UInt8 and Int16.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE u8 & -1::smallint = 200 AND ~u8 = -201 AND u8 # -1::smallint = -201;
                                                                                          QUERY PLAN                                                                                          
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((bitAnd(toInt16(u8), toInt16((-1))) = 200)) AND ((bitNot(toInt16(u8)) = (-201))) AND ((bitXor(toInt16(u8), toInt16((-1))) = (-201)))
(3 rows)

SELECT id FROM nums WHERE u8 & -1::smallint = 200 AND ~u8 = -201 AND u8 # -1::smallint = -201;
 id 
----
  1
(1 row)

SELECT id FROM nums WHERE i16 | 3::smallint = -1;
 id 
----
  1
(1 row)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE u8 << 1 = 400;
                                               QUERY PLAN                                               
--------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((bitShiftLeft(toInt16(u8), toInt16(1)) = 400))
(3 rows)

SELECT id FROM nums WHERE u8 << 1 = 400;
 id 
----
  1
(1 row)

SELECT id FROM nums WHERE i16 << 2 = 0;
 id 
----
  2
(1 row)

SELECT id FROM nums WHERE i64 >> 1 = -4;
 id 
----
  2
(1 row)

-- Push down variable counts and counts beyond integer width.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE i32 << 32 = -7;
                                                QUERY PLAN                                                 
-----------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((bitShiftLeft(toInt32(i32), toInt32(32)) = (-7)))
(3 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE i32 << i32 = 2;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((bitShiftLeft(toInt32(i32), toInt32(i32)) = 2))
(3 rows)

-- Divide integers exactly, rounding toward zero.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE i64 / 1 = 9007199254740993 AND i32 / 2 = -3;
                                                                           QUERY PLAN                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((intDiv(toInt64(i64), toInt64(1)) = 9007199254740993)) AND ((intDiv(toInt32(i32), toInt32(2)) = (-3)))
(3 rows)

SELECT id FROM nums WHERE i64 / 1 = 9007199254740993 AND i32 / 2 = -3;
 id 
----
  1
(1 row)

-- Map math operators to ClickHouse functions.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE f64 ^ 2 = 64 AND ||/ f64 = 2 AND @ i32 = 7 AND @ n = 1.5;
                                                                                  QUERY PLAN                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((pow(f64, 2) = 64)) AND ((cbrt(f64) = 2)) AND ((abs(toInt32(i32)) = 7)) AND ((abs(n) = cast('1.5', 'Decimal(2, 1)')))
(3 rows)

SELECT id FROM nums WHERE f64 ^ 2 = 64 AND ||/ f64 = 2 AND @ i32 = 7 AND @ n = 1.5;
 id 
----
  1
(1 row)

SELECT id FROM nums WHERE |/ f64 = 2;
 id 
----
  2
(1 row)

-- Round real arithmetic and constants to Float32.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE f32 + 0.2::real = 0.3::real;
                                                      QUERY PLAN                                                       
-----------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((toFloat32(f32 + 0.20000000298023224) = 0.30000001192092896))
(3 rows)

SELECT id FROM nums WHERE f32 + 0.2::real = 0.3::real;
 id 
----
  1
(1 row)

SELECT id FROM nums WHERE f32 = 0.3::real;
 id 
----
  2
(1 row)

SELECT id FROM nums WHERE f32 IN (0.3::real, 0.7::real);
 id 
----
  2
(1 row)

-- Use divideDecimal to keep decimal places when dividing numeric values.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE n / 3 > 0.83 AND n / 0.1 = 25;
                                                                                                                                   QUERY PLAN                                                                                                                                   
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((round(divideDecimal(toDecimal256(n, 2), toDecimal256(3, 38), 17), 16) > cast('0.83', 'Decimal(3, 2)'))) AND ((round(divideDecimal(toDecimal256(n, 2), toDecimal256(cast('0.1', 'Decimal(2, 1)'), 38), 17), 16) = 25))
(3 rows)

SELECT id FROM nums WHERE n / 3 > 0.83 AND n / 0.1 = 25;
 id 
----
  2
(1 row)

-- Use Decimal literals to avoid rounding fractions and integers beyond UInt64 range.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE n > 2.4999999999999999 OR i64::numeric * 10000 = 90071992547409930000;
                                                                                                      QUERY PLAN                                                                                                       
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE (((n > cast('2.4999999999999999', 'Decimal(17, 16)')) OR ((cast(i64, 'Nullable(Decimal(76, 38))') * 10000) = cast('90071992547409930000', 'Decimal(20, 0)'))))
(3 rows)

SELECT id FROM nums WHERE n > 2.4999999999999999 OR i64::numeric * 10000 = 90071992547409930000 ORDER BY id;
 id 
----
  1
  2
(2 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE n * 2 = -3;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE (((n * 2) = (-3)))
(3 rows)

-- Compare inet only for equality.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE ip = '10.0.0.1' AND ip6 <> '2001:db8::1';
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((ip6 <> '2001:db8::1')) AND ((ip = '10.0.0.1'))
(3 rows)

SELECT id FROM nums WHERE ip = '10.0.0.1' AND ip6 <> '2001:db8::1';
 id 
----
  1
(1 row)

SELECT id FROM nums WHERE ip IN ('10.0.0.2', '10.0.0.9');
 id 
----
  2
(1 row)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE ip < '10.0.0.2' OR ip::text = '10.0.0.2/32' ORDER BY id;
                                     QUERY PLAN                                      
-------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Filter: ((nums.ip < '10.0.0.2'::inet) OR ((nums.ip)::text = '10.0.0.2/32'::text))
   Remote SQL: SELECT id, ip FROM operators_test.nums ORDER BY id ASC NULLS LAST
(4 rows)

SELECT id FROM nums WHERE ip < '10.0.0.2' OR ip::text = '10.0.0.2/32' ORDER BY id;
 id 
----
  1
  2
(2 rows)

-- Concatenate bytea.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE bin || '\x02'::bytea = '\x0102'::bytea;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE (((bin || '\x02') = '\x01\x02'))
(3 rows)

SELECT id FROM nums WHERE bin || '\x02'::bytea = '\x0102'::bytea;
 id 
----
  1
(1 row)

-- Compare UUIDs only for equality, as ClickHouse orders UUIDs differently.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE uid = '00000000-0000-0000-0000-000000000001';
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Remote SQL: SELECT id FROM operators_test.nums WHERE ((uid = '00000000-0000-0000-0000-000000000001'))
(3 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM nums WHERE uid > '00000000-0000-0000-0000-000000000001';
                             QUERY PLAN                              
---------------------------------------------------------------------
 Foreign Scan on public.nums
   Output: id
   Filter: (nums.uid > '00000000-0000-0000-0000-000000000001'::uuid)
   Remote SQL: SELECT id, uid FROM operators_test.nums
(4 rows)

SELECT id FROM nums WHERE uid > '00000000-0000-0000-0000-000000000001';
 id 
----
  1
(1 row)

-- Plan other operators without ClickHouse equivalent locally.
CREATE FOREIGN TABLE plan_only (
    j  jsonb,
    tm time,
    ts timestamp,
    d  date
) SERVER operators_loopback OPTIONS (table_name 'nums');
EXPLAIN (VERBOSE, COSTS OFF)
SELECT 1 FROM plan_only WHERE j - 'a' = '{}' OR j < '{"a": 1}';
                                         QUERY PLAN                                         
--------------------------------------------------------------------------------------------
 Foreign Scan on public.plan_only
   Output: 1
   Filter: (((plan_only.j - 'a'::text) = '{}'::jsonb) OR (plan_only.j < '{"a": 1}'::jsonb))
   Remote SQL: SELECT j FROM operators_test.nums
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT 1 FROM plan_only WHERE j = ANY (ARRAY['{}'::jsonb]);
                    QUERY PLAN                     
---------------------------------------------------
 Foreign Scan on public.plan_only
   Output: 1
   Filter: (plan_only.j = ANY ('{"{}"}'::jsonb[]))
   Remote SQL: SELECT j FROM operators_test.nums
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT 1 FROM plan_only WHERE tm + interval '2 hours' < '01:30' OR d + tm > now();
                                                             QUERY PLAN                                                              
-------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.plan_only
   Output: 1
   Filter: (((plan_only.tm + '@ 2 hours'::interval) < '01:30:00'::time without time zone) OR ((plan_only.d + plan_only.tm) > now()))
   Remote SQL: SELECT tm, d FROM operators_test.nums
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT 1 FROM plan_only WHERE ts - ts > interval '1 month';
                           QUERY PLAN                            
-----------------------------------------------------------------
 Foreign Scan on public.plan_only
   Output: 1
   Filter: ((plan_only.ts - plan_only.ts) > '@ 1 mon'::interval)
   Remote SQL: SELECT ts FROM operators_test.nums
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT 1 FROM plan_only WHERE ts - ts > interval '1 hour' AND d + interval '1 month' > now();
                                                       QUERY PLAN                                                       
------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.plan_only
   Output: 1
   Remote SQL: SELECT NULL FROM operators_test.nums WHERE (((ts - ts) > 3600)) AND (((d + INTERVAL 1 MONTH) > now64()))
(3 rows)

CALL clickhouse_perform('operators_admin', 'DROP DATABASE operators_test');
DROP USER MAPPING FOR CURRENT_USER SERVER operators_loopback;
DROP SERVER operators_loopback CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to foreign table nums
drop cascades to foreign table plan_only
DROP USER MAPPING FOR CURRENT_USER SERVER operators_admin;
DROP SERVER operators_admin;
