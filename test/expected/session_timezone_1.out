-- Verify epoch extraction interprets timestamp wall clock times as UTC.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM stz_bin_wall WHERE date_part('epoch', ts) = 1719835200;
                                                                                         QUERY PLAN                                                                                          
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.stz_bin_wall
   Output: id
   Remote SQL: SELECT id FROM stz_test.wall WHERE (((toDecimal64(toDateTime64(ts, 6, 'America/Los_Angeles'), 6) + timeZoneOffset(toDateTime64(ts, 6, 'America/Los_Angeles'))) = 1719835200))
(3 rows)

SELECT id FROM stz_bin_wall WHERE date_part('epoch', ts) = 1719835200 ORDER BY id;
 id 
----
  1
  2
  3
(3 rows)

SELECT id FROM stz_http_wall WHERE date_part('epoch', ts) = 1719835200 ORDER BY id;
 id 
----
  1
  2
  3
(3 rows)

SELECT id FROM stz_bin_utc WHERE extract(epoch FROM ts) = 1577872800;
 id 
----
  0
(1 row)

-- Verify timezone() evaluates locally.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM stz_bin_utc WHERE date_part('hour', ts AT TIME ZONE 'UTC') = 10;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Foreign Scan on public.stz_bin_utc
   Output: id
   Filter: (date_part('hour'::text, (stz_bin_utc.ts AT TIME ZONE 'UTC'::text)) = '10'::double precision)
   Remote SQL: SELECT id, ts FROM stz_test.utc
(4 rows)

SELECT id FROM stz_bin_utc WHERE date_part('hour', ts AT TIME ZONE 'UTC') = 10 ORDER BY id;
 id 
----
  0
  1
  2
  3
(4 rows)

-- Verify second and epoch extraction preserve microseconds before 1970.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, date_part('second', ts), extract(epoch FROM ts) FROM stz_bin_day
 WHERE date_part('second', ts) > 5 ORDER BY id;
                                                                                                                                    QUERY PLAN                                                                                                                                    
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.stz_bin_day
   Output: id, date_part('second'::text, ts), EXTRACT(epoch FROM ts)
   Remote SQL: SELECT id, ts FROM stz_test.day WHERE (((toSecond(toDateTime64(ts, 6, 'America/Los_Angeles')) + (toDecimal64(toDateTime64(ts, 6, 'America/Los_Angeles'), 6) - floor(toDecimal64(toDateTime64(ts, 6, 'America/Los_Angeles'), 6)))) > 5)) ORDER BY id ASC NULLS LAST
(3 rows)

SELECT id, date_part('second', ts), extract(epoch FROM ts) FROM stz_bin_day
 WHERE date_part('second', ts) > 5 ORDER BY id;
 id | date_part |      extract      
----+-----------+-------------------
  1 |      5.25 | 1583575205.250000
  2 |     58.75 |         -1.250000
(2 rows)

SELECT id, date_part('second', ts), extract(epoch FROM ts) FROM stz_http_day
 WHERE date_part('second', ts) > 5 ORDER BY id;
 id | date_part |      extract      
----+-----------+-------------------
  1 |      5.25 | 1583575205.250000
  2 |     58.75 |         -1.250000
(2 rows)

-- Verify date_trunc supports dates before 1970.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM stz_bin_day
 WHERE date_trunc('month', ts) = '1969-12-01' AND date_trunc('hour', ts) = '1969-12-31 15:00';
                                                                                                                                                              QUERY PLAN                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.stz_bin_day
   Output: id
   Remote SQL: SELECT id FROM stz_test.day WHERE ((toDateTime64(toStartOfMonth(toDateTime64(ts, 6, 'America/Los_Angeles')), 6, 'America/Los_Angeles') = cast('1969-12-01 08:00:00' as DateTime64(6, 'UTC')))) AND ((toStartOfHour(toDateTime64(ts, 6, 'America/Los_Angeles')) = cast('1969-12-31 23:00:00' as DateTime64(6, 'UTC'))))
(3 rows)

SELECT id FROM stz_bin_day
 WHERE date_trunc('month', ts) = '1969-12-01' AND date_trunc('hour', ts) = '1969-12-31 15:00';
 id 
----
  2
(1 row)

SELECT id FROM stz_http_day
 WHERE date_trunc('month', ts) = '1969-12-01' AND date_trunc('hour', ts) = '1969-12-31 15:00';
 id 
----
  2
(1 row)

-- Verify Date mapped to timestamp uses midnight and supports day arithmetic.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, d FROM stz_bin_day
 WHERE date_trunc('month', d) = '2020-03-01' AND d + interval '1 day' = '2020-03-08'
   AND date_part('epoch', d) = 1583539200;
                                                                                                                                                                                                         QUERY PLAN                                                                                                                                                                                                         
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.stz_bin_day
   Output: id, d
   Remote SQL: SELECT id, d FROM stz_test.day WHERE ((toDateTime64(toStartOfMonth(toDateTime64(d, 6, 'America/Los_Angeles')), 6, 'America/Los_Angeles') = '2020-03-01 00:00:00')) AND (((toDateTime64(d, 6, 'America/Los_Angeles') + INTERVAL 1 DAY) = '2020-03-08 00:00:00')) AND (((toDecimal64(toDateTime64(d, 6, 'America/Los_Angeles'), 6) + timeZoneOffset(toDateTime64(d, 6, 'America/Los_Angeles'))) = 1583539200))
(3 rows)

SELECT id, d FROM stz_bin_day
 WHERE date_trunc('month', d) = '2020-03-01' AND d + interval '1 day' = '2020-03-08'
   AND date_part('epoch', d) = 1583539200;
 id |          d          
----+---------------------
  1 | 2020-03-07 00:00:00
(1 row)

SELECT id, d FROM stz_http_day
 WHERE date_trunc('month', d) = '2020-03-01' AND d + interval '1 day' = '2020-03-08'
   AND date_part('epoch', d) = 1583539200;
 id |          d          
----+---------------------
  1 | 2020-03-07 00:00:00
(1 row)

-- Verify date() uses TimeZone: 10:00 UTC falls on next day at UTC+14.
SET timezone = 'Pacific/Kiritimati';
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, date(ts) FROM stz_bin_utc WHERE date(ts) = '2020-01-02';
                                                        QUERY PLAN                                                        
--------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.stz_bin_utc
   Output: id, date(ts)
   Remote SQL: SELECT id, ts FROM stz_test.utc WHERE ((toDate(toDateTime64(ts, 6, 'Pacific/Kiritimati')) = '2020-01-02'))
(3 rows)

SELECT id, date(ts) FROM stz_bin_utc WHERE date(ts) = '2020-01-02';
 id |    date    
----+------------
  0 | 2020-01-02
(1 row)

SELECT id, date(ts) FROM stz_http_utc WHERE date(ts) = '2020-01-02';
 id |    date    
----+------------
  0 | 2020-01-02
(1 row)

RESET timezone;
CALL clickhouse_perform('stz_admin', 'DROP DATABASE stz_test');
DROP USER MAPPING FOR CURRENT_USER SERVER stz_bin_svr;
DROP SERVER stz_bin_svr CASCADE;
NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to foreign table stz_bin_wall
drop cascades to foreign table stz_bin_utc
drop cascades to foreign table stz_bin_day
DROP USER MAPPING FOR CURRENT_USER SERVER stz_http_svr;
DROP SERVER stz_http_svr CASCADE;
NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to foreign table stz_http_wall
drop cascades to foreign table stz_http_utc
drop cascades to foreign table stz_http_day
DROP USER MAPPING FOR CURRENT_USER SERVER stz_admin;
DROP SERVER stz_admin;
