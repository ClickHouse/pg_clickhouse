(8 rows)

-- EXISTS with extra filter in subquery, under OR
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, status FROM spd_orders
WHERE EXISTS (
    SELECT 1 FROM items
    WHERE order_id = id AND shipped > promised
)
   OR amount > 400.00
ORDER BY id;
                                                                                              QUERY PLAN                                                                                               
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.status
   Remote SQL: SELECT id, status FROM subquery_test.spd_orders WHERE ((id IN (SELECT order_id FROM subquery_test.items WHERE ((shipped > promised))) OR (amount > 400.00))) ORDER BY id ASC NULLS LAST
   SubPlan 2
     ->  Foreign Scan on subquery_test.items
           Output: items.order_id
           Remote SQL: SELECT order_id FROM subquery_test.items WHERE ((shipped > promised))
(7 rows)

SELECT id, status FROM spd_orders
WHERE EXISTS (
    SELECT 1 FROM items
    WHERE order_id = id AND shipped > promised
)
   OR amount > 400.00
ORDER BY id;
 id | status 
----+--------
  1 | open
  3 | closed
  4 | open
  5 | closed
(4 rows)

-- OR'd EXISTS from different tables (two SubPlans)
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, status FROM spd_orders
WHERE EXISTS (SELECT 1 FROM items WHERE order_id = id)
   OR EXISTS (SELECT 1 FROM returns WHERE order_id = id)
ORDER BY id;
                                                                                                QUERY PLAN                                                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.status
   Remote SQL: SELECT id, status FROM subquery_test.spd_orders WHERE ((id IN (SELECT order_id FROM subquery_test.items) OR id IN (SELECT order_id FROM subquery_test.returns))) ORDER BY id ASC NULLS LAST
   SubPlan 2
     ->  Foreign Scan on subquery_test.items
           Output: items.order_id
           Remote SQL: SELECT order_id FROM subquery_test.items
   SubPlan 4
     ->  Foreign Scan on subquery_test.returns
           Output: returns.order_id
           Remote SQL: SELECT order_id FROM subquery_test.returns
(11 rows)

SELECT id, status FROM spd_orders
WHERE EXISTS (SELECT 1 FROM items WHERE order_id = id)
   OR EXISTS (SELECT 1 FROM returns WHERE order_id = id)
ORDER BY id;
 id | status 
----+--------
  1 | open
  2 | open
  3 | closed
  4 | open
  7 | open
(5 rows)

-- Nested subquery: EXISTS with uncorrelated scalar (InitPlan inside SubPlan).
-- Pushdown rejected; PG falls back to local SubPlan execution.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, status FROM spd_orders
WHERE EXISTS (
    SELECT 1 FROM items
    WHERE order_id = id AND qty > (SELECT avg(qty) FROM items)
)
   OR status = 'closed'
ORDER BY id;
                                             QUERY PLAN                                              
-----------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.status
   Filter: ((ANY (spd_orders.id = (hashed SubPlan 4).col1)) OR (spd_orders.status = 'closed'::text))
   Remote SQL: SELECT id, status FROM subquery_test.spd_orders ORDER BY id ASC NULLS LAST
   SubPlan 4
     ->  Foreign Scan on subquery_test.items items_1
           Output: items_1.order_id
           Remote SQL: SELECT order_id FROM subquery_test.items WHERE ((qty > {p1:Decimal(38, 10)}))
           InitPlan 3
             ->  Foreign Scan
                   Output: (avg(items.qty))
                   Relations: Aggregate on (items)
                   Remote SQL: SELECT avg(qty) FROM subquery_test.items
(13 rows)

SELECT id, status FROM spd_orders
WHERE EXISTS (
    SELECT 1 FROM items
    WHERE order_id = id AND qty > (SELECT avg(qty) FROM items)
)
   OR status = 'closed'
ORDER BY id;
 id | status 
----+--------
  1 | open
  2 | open
  3 | closed
  4 | open
  5 | closed
  8 | closed
(6 rows)

-- Nested subquery: scalar in SELECT with nested aggregate (InitPlan)
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id,
       (SELECT count(*) FROM items
        WHERE order_id = spd_orders.id
        AND qty > (SELECT avg(qty) FROM items)) AS above_avg_count
FROM spd_orders
ORDER BY id;
                                                            QUERY PLAN                                                             
-----------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, (SubPlan 2)
   Remote SQL: SELECT id FROM subquery_test.spd_orders ORDER BY id ASC NULLS LAST
   SubPlan 2
     ->  Foreign Scan
           Output: (count(*))
           Relations: Aggregate on (items)
           Remote SQL: SELECT count(*) FROM subquery_test.items WHERE ((qty > {p1:Decimal(38, 10)})) AND ((order_id = {p2:Int32}))
           InitPlan 1
             ->  Foreign Scan
                   Output: (avg(items.qty))
                   Relations: Aggregate on (items)
                   Remote SQL: SELECT avg(qty) FROM subquery_test.items
(13 rows)

SELECT id,
       (SELECT count(*) FROM items
        WHERE order_id = spd_orders.id
        AND qty > (SELECT avg(qty) FROM items)) AS above_avg_count
FROM spd_orders
ORDER BY id;
 id | above_avg_count 
----+-----------------
  1 |               1
  2 |               1
  3 |               0
  4 |               1
  5 |               0
  6 |               0
  7 |               0
  8 |               0
(8 rows)

