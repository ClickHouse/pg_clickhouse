IMPORT FOREIGN SCHEMA "subquery_test" LIMIT TO (spd_orders, items, returns)
    FROM SERVER subquery_loopback INTO subquery_test;
-- EXISTS under OR (EXISTS_SUBLINK) — OR blocks semi-join conversion
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, status FROM spd_orders
WHERE EXISTS (SELECT 1 FROM items WHERE order_id = id)
   OR status = 'closed'
ORDER BY id;
                                                                                 QUERY PLAN                                                                                 
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.status
   Remote SQL: SELECT id, status FROM subquery_test.spd_orders WHERE ((id IN (SELECT order_id FROM subquery_test.items) OR (status = 'closed'))) ORDER BY id ASC NULLS LAST
   SubPlan 2
     ->  Foreign Scan on subquery_test.items
           Output: items.order_id
           Remote SQL: SELECT order_id FROM subquery_test.items
(7 rows)

SELECT id, status FROM spd_orders
WHERE EXISTS (SELECT 1 FROM items WHERE order_id = id)
   OR status = 'closed'
ORDER BY id;
 id | status 
----+--------
  1 | open
  2 | open
  3 | closed
  4 | open
  5 | closed
  7 | open
  8 | closed
(7 rows)

-- IN under OR (ANY_SUBLINK) — OR blocks semi-join conversion
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, amount FROM spd_orders
WHERE id IN (SELECT order_id FROM returns)
   OR amount > 400.00
ORDER BY id;
                                                                                 QUERY PLAN                                                                                 
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.amount
   Remote SQL: SELECT id, amount FROM subquery_test.spd_orders WHERE ((id IN (SELECT order_id FROM subquery_test.returns) OR (amount > 400.00))) ORDER BY id ASC NULLS LAST
   SubPlan 1
     ->  Foreign Scan on subquery_test.returns
           Output: returns.order_id
           Remote SQL: SELECT order_id FROM subquery_test.returns
(7 rows)

SELECT id, amount FROM spd_orders
WHERE id IN (SELECT order_id FROM returns)
   OR amount > 400.00
ORDER BY id;
 id | amount 
----+--------
  1 | 100.00
  3 | 300.00
  4 | 400.00
  5 | 500.00
(4 rows)

-- NOT IN (ANY_SUBLINK with NOT wrapper)
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, amount FROM spd_orders
WHERE id NOT IN (SELECT order_id FROM returns)
ORDER BY id;
                                                                        QUERY PLAN                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.amount
   Remote SQL: SELECT id, amount FROM subquery_test.spd_orders WHERE ((NOT id IN (SELECT order_id FROM subquery_test.returns))) ORDER BY id ASC NULLS LAST
   SubPlan 1
     ->  Foreign Scan on subquery_test.returns
           Output: returns.order_id
           Remote SQL: SELECT order_id FROM subquery_test.returns
(7 rows)

SELECT id, amount FROM spd_orders
WHERE id NOT IN (SELECT order_id FROM returns)
ORDER BY id;
 id | amount 
----+--------
  2 | 200.00
  5 | 500.00
  6 | 150.00
  7 | 250.00
  8 | 350.00
(5 rows)

-- Scalar subquery in SELECT (EXPR_SUBLINK)
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, status,
       (SELECT count(*) FROM items WHERE order_id = id) AS item_count
FROM spd_orders
ORDER BY id;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, spd_orders.status, (SubPlan 1)
   Remote SQL: SELECT id, status FROM subquery_test.spd_orders ORDER BY id ASC NULLS LAST
   SubPlan 1
     ->  Foreign Scan
           Output: (count(*))
           Relations: Aggregate on (items)
           Remote SQL: SELECT count(*) FROM subquery_test.items WHERE ((order_id = {p1:Int32}))
(8 rows)

SELECT id, status,
       (SELECT count(*) FROM items WHERE order_id = id) AS item_count
FROM spd_orders
ORDER BY id;
 id | status | item_count 
----+--------+------------
  1 | open   |          2
  2 | open   |          1
  3 | closed |          1
  4 | open   |          2
  5 | closed |          0
  6 | open   |          0
  7 | open   |          1
  8 | closed |          0
(8 rows)

-- Scalar subquery with aggregate (EXPR_SUBLINK)
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id,
       (SELECT max(qty) FROM items WHERE order_id = id) AS max_qty
FROM spd_orders
ORDER BY id;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Foreign Scan on subquery_test.spd_orders
   Output: spd_orders.id, (SubPlan 1)
   Remote SQL: SELECT id FROM subquery_test.spd_orders ORDER BY id ASC NULLS LAST
   SubPlan 1
     ->  Foreign Scan
           Output: (max(items.qty))
           Relations: Aggregate on (items)
           Remote SQL: SELECT max(qty) FROM subquery_test.items WHERE ((order_id = {p1:Int32}))
(8 rows)

SELECT id,
       (SELECT max(qty) FROM items WHERE order_id = id) AS max_qty
FROM spd_orders
ORDER BY id;
