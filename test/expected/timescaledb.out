-- A stride with months, a stride that is not positive, and a stride or
-- origin that is not constant all evaluate in Postgres.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT time_bucket('1 month', ts) AS b FROM ts_metrics GROUP BY b;
                          QUERY PLAN                          
--------------------------------------------------------------
 HashAggregate
   Output: (time_bucket('@ 1 mon'::interval, ts))
   Group Key: time_bucket('@ 1 mon'::interval, ts_metrics.ts)
   ->  Foreign Scan on public.ts_metrics
         Output: time_bucket('@ 1 mon'::interval, ts)
         Remote SQL: SELECT ts FROM timescaledb_test.metrics
(6 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT time_bucket('-1 hour', ts) AS b FROM ts_metrics GROUP BY b;
                            QUERY PLAN                             
-------------------------------------------------------------------
 HashAggregate
   Output: (time_bucket('@ 1 hour ago'::interval, ts))
   Group Key: time_bucket('@ 1 hour ago'::interval, ts_metrics.ts)
   ->  Foreign Scan on public.ts_metrics
         Output: time_bucket('@ 1 hour ago'::interval, ts)
         Remote SQL: SELECT ts FROM timescaledb_test.metrics
(6 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT time_bucket(make_interval(mins => n), ts) AS b FROM ts_metrics GROUP BY b;
                                                 QUERY PLAN                                                 
------------------------------------------------------------------------------------------------------------
 HashAggregate
   Output: (time_bucket(make_interval(0, 0, 0, 0, 0, n, '0'::double precision), ts))
   Group Key: time_bucket(make_interval(0, 0, 0, 0, 0, ts_metrics.n, '0'::double precision), ts_metrics.ts)
   ->  Foreign Scan on public.ts_metrics
         Output: time_bucket(make_interval(0, 0, 0, 0, 0, n, '0'::double precision), ts)
         Remote SQL: SELECT ts, n FROM timescaledb_test.metrics
(6 rows)

EXPLAIN (VERBOSE, COSTS OFF)
SELECT time_bucket('1 hour', ts, ts64) AS b FROM ts_metrics GROUP BY b;
