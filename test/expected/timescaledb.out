-- Pushes down in WHERE.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id FROM ts_metrics
 WHERE time_bucket('1 hour', ts) = '2024-03-10 02:00:00-05' ORDER BY id;
                                                                                                        QUERY PLAN                                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.ts_metrics
   Output: id
   Remote SQL: SELECT id FROM timescaledb_test.metrics WHERE ((toStartOfInterval(toDateTime64(ts, 6), INTERVAL 3600000000 MICROSECOND) = cast('2024-03-10 07:00:00' as DateTime64(6, 'UTC')))) ORDER BY id ASC NULLS LAST
(3 rows)

SELECT id FROM ts_metrics
 WHERE time_bucket('1 hour', ts) = '2024-03-10 02:00:00-05' ORDER BY id;
 id 
----
  2
  3
(2 rows)

-- Every stride and origin must match TimescaleDB for every row and column.
-- Grouping pushes the remote time_bucket() down.
CREATE FUNCTION ts_bucket_diff(stride interval, origin timestamptz)
RETURNS TABLE (id int, col text, remote timestamptz, local timestamptz)
LANGUAGE plpgsql AS $$
DECLARE
    c    text;
    call text;
BEGIN
    FOREACH c IN ARRAY ARRAY['ts', 'ts64', 'nts'] LOOP
        call := CASE WHEN origin IS NULL
            THEN format('time_bucket(%L, %I)', stride, c)
            ELSE format('time_bucket(%L, %I, %L::timestamptz)', stride, c, origin)
        END;
        RETURN QUERY EXECUTE format($q$
            SELECT r.id, %L, r.b, l.b
              FROM (SELECT id, %s AS b FROM ts_metrics GROUP BY id, b) r
              JOIN (SELECT id, %s AS b FROM ts_local) l USING (id)
             WHERE r.b IS DISTINCT FROM l.b
        $q$, c, call, call);
    END LOOP;
END;
$$;
SELECT s.stride, o.origin, d.*
  FROM (VALUES
        ('1 second'::interval), ('7 seconds'), ('5 minutes'), ('15 minutes'),
        ('1 hour'), ('5 hours'), ('1 day'), ('7 days'), ('1 day 02:30:00'),
        ('00:00:00.25'), ('00:00:00.000007'), ('30 days'), ('10000 days')
       ) AS s(stride),
       (VALUES
        (NULL::timestamptz), ('2001-01-01 00:02:30+00'),
        ('1970-01-01 00:00:00+00'), ('1969-07-20 20:17:40.123456+00'),
        ('2300-05-05 05:05:05.5+00')
       ) AS o(origin),
       ts_bucket_diff(s.stride, o.origin) AS d
 ORDER BY 1, 2, 3, 4;
 stride | origin | id | col | remote | local 
--------+--------+----+-----+--------+-------
(0 rows)

-- first() and last() keep a NULL value on the first or last row, and ignore
-- rows with a NULL time.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT device, first(val, ts), last(val, ts), first(n, nts), last(n, nts)
  FROM ts_metrics GROUP BY device ORDER BY device;
                                                                                                                                                      QUERY PLAN                                                                                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: device, (first(val, ts)), (last(val, ts)), (first(n, nts)), (last(n, nts))
   Relations: Aggregate on (ts_metrics)
   Remote SQL: SELECT device, if(count(ts) > 0, argMin(tuple(val), ts).1, NULL), if(count(ts) > 0, argMax(tuple(val), ts).1, NULL), if(count(nts) > 0, argMin(tuple(n), nts).1, NULL), if(count(nts) > 0, argMax(tuple(n), nts).1, NULL) FROM timescaledb_test.metrics GROUP BY device ORDER BY device ASC NULLS LAST
(4 rows)

SELECT device, first(val, ts), last(val, ts), first(n, nts), last(n, nts)
  FROM ts_metrics GROUP BY device ORDER BY device;
 device | first | last | first | last 
--------+-------+------+-------+------
      1 |       |      |     1 |    3
      2 |   4.5 |  5.5 |     4 |    4
      3 |   6.5 |  7.5 |     6 |    7
      4 |   8.5 |  8.5 |       |     
(4 rows)

SELECT device, first(val, ts), last(val, ts), first(n, nts), last(n, nts)
  FROM ts_local GROUP BY device ORDER BY device;
 device | first | last | first | last 
--------+-------+------+-------+------
      1 |       |      |     1 |    3
      2 |   4.5 |  5.5 |     4 |    4
      3 |   6.5 |  7.5 |     6 |    7
      4 |   8.5 |  8.5 |       |     
(4 rows)

-- With time_bucket() and FILTER.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT time_bucket('1 day', ts) AS b, first(n, ts), last(val, ts) FILTER (WHERE n > 1)
  FROM ts_metrics GROUP BY b ORDER BY b;
                                                                                                                                                                                                                         QUERY PLAN                                                                                                                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: (time_bucket('@ 1 day'::interval, ts)), (first(n, ts)), (last(val, ts) FILTER (WHERE (n > 1)))
   Relations: Aggregate on (ts_metrics)
   Remote SQL: SELECT toStartOfInterval(toDateTime64(ts, 6), INTERVAL 86400000000 MICROSECOND), if(count(ts) > 0, argMin(tuple(n), ts).1, NULL), if(countIf(ts, (((n > 1)) > 0)) > 0, argMaxIf(tuple(val), ts, (((n > 1)) > 0)).1, NULL) FROM timescaledb_test.metrics GROUP BY (toStartOfInterval(toDateTime64(ts, 6), INTERVAL 86400000000 MICROSECOND)) ORDER BY toStartOfInterval(toDateTime64(ts, 6), INTERVAL 86400000000 MICROSECOND) ASC NULLS LAST
(4 rows)

SELECT time_bucket('1 day', ts) AS b, first(n, ts), last(val, ts) FILTER (WHERE n > 1)
  FROM ts_metrics GROUP BY b ORDER BY b;
           b            | first | last 
------------------------+-------+------
 1969-12-31 19:00:00-05 |     6 |  6.5
 1999-12-31 19:00:00-05 |     7 |  7.5
 2024-03-09 19:00:00-05 |     1 |     
 2024-11-02 20:00:00-04 |     4 |  5.5
 2105-12-30 19:00:00-05 |     8 |  8.5
(5 rows)

SELECT time_bucket('1 day', ts) AS b, first(n, ts), last(val, ts) FILTER (WHERE n > 1)
