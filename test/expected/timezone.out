-- Extract and truncate timestamptz in PostgreSQL TimeZone, not column zone.
SET session timezone = 'America/New_York';
EXPLAIN (VERBOSE, COSTS OFF)
SELECT date_trunc('day', lax_ts) AS d, date_part('hour', utc_ts) AS h,
       to_char(nyc_ts, 'HH24') AS c, to_char(utc_ts::date, 'YYYY-MM') AS m
  FROM tz_bin.ts GROUP BY d, h, c, m ORDER BY d;
                                                                                                                                                                                                                                                     QUERY PLAN                                                                                                                                                                                                                                                     
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: (date_trunc('day'::text, lax_ts)), (date_part('hour'::text, utc_ts)), (to_char(nyc_ts, 'HH24'::text)), (to_char(((utc_ts)::date)::timestamp with time zone, 'YYYY-MM'::text))
   Relations: Aggregate on (ts)
   Remote SQL: SELECT toStartOfDay(lax_ts, 'America/New_York'), toHour(utc_ts, 'America/New_York'), formatDateTime(nyc_ts, '%H', 'America/New_York'), formatDateTime(toDate32(utc_ts, 'America/New_York'), '%Y-%m') FROM tz_test.ts GROUP BY (toStartOfDay(lax_ts, 'America/New_York')), (toHour(utc_ts, 'America/New_York')), (formatDateTime(nyc_ts, '%H', 'America/New_York')), (formatDateTime(toDate32(utc_ts, 'America/New_York'), '%Y-%m')) ORDER BY toStartOfDay(lax_ts, 'America/New_York') ASC NULLS LAST
(4 rows)

SELECT date_trunc('day', lax_ts) AS d, date_part('hour', utc_ts) AS h,
       to_char(nyc_ts, 'HH24') AS c, to_char(utc_ts::date, 'YYYY-MM') AS m
  FROM tz_bin.ts GROUP BY d, h, c, m ORDER BY d;
           d            | h | c  |    m    
------------------------+---+----+---------
 2020-01-01 00:00:00-05 | 5 | 05 | 2020-01
 2020-04-01 00:00:00-04 | 6 | 06 | 2020-04
 2020-07-01 00:00:00-04 | 6 | 06 | 2020-07
 2020-10-01 00:00:00-04 | 6 | 06 | 2020-10
(4 rows)

