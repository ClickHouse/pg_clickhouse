-- Wall clock 02:30 falls in Los Angeles DST gap, so must not pass through it.
CALL clickhouse_perform('tz_admin', $$
    CREATE TABLE tz_test.gap (ts DateTime('UTC')) ENGINE = MergeTree ORDER BY ts
$$);
CALL clickhouse_perform('tz_admin', $$
    INSERT INTO tz_test.gap VALUES ('2020-03-08 02:30:00')
$$);
CREATE FOREIGN TABLE tz_bin.gap (ts timestamptz) SERVER tz_bin_svr
    OPTIONS (database 'tz_test');
SET session timezone = 'America/Los_Angeles';
EXPLAIN (VERBOSE, COSTS OFF)
SELECT date_part('hour', ts AT TIME ZONE 'UTC') AS h,
       date_part('epoch', ts AT TIME ZONE 'UTC') AS e,
       to_char(ts AT TIME ZONE 'UTC', 'HH24:MI') AS c,
       (ts AT TIME ZONE 'UTC')::date AS d,
       (ts AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS r
  FROM tz_bin.gap GROUP BY h, e, c, d, r;
                                                                                                                                                                                                              QUERY PLAN                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Output: (date_part('hour'::text, (ts AT TIME ZONE 'UTC'::text))), (date_part('epoch'::text, (ts AT TIME ZONE 'UTC'::text))), (to_char((ts AT TIME ZONE 'UTC'::text), 'HH24:MI'::text)), (((ts AT TIME ZONE 'UTC'::text))::date), (((ts AT TIME ZONE 'UTC'::text) AT TIME ZONE 'UTC'::text))
   Relations: Aggregate on (gap)
   Remote SQL: SELECT toHour(ts, 'UTC'), toUnixTimestamp(toDateTime64(toString(ts, 'UTC'), 6, 'UTC')), formatDateTime(ts, '%H:%i', 'UTC'), toDate32(ts, 'UTC'), toDateTime64(toString(ts, 'UTC'), 6, 'UTC') FROM tz_test.gap GROUP BY (toHour(ts, 'UTC')), (toUnixTimestamp(toDateTime64(toString(ts, 'UTC'), 6, 'UTC'))), (formatDateTime(ts, '%H:%i', 'UTC')), (toDate32(ts, 'UTC')), (toDateTime64(toString(ts, 'UTC'), 6, 'UTC'))
(4 rows)

SELECT date_part('hour', ts AT TIME ZONE 'UTC') AS h,
       date_part('epoch', ts AT TIME ZONE 'UTC') AS e,
       to_char(ts AT TIME ZONE 'UTC', 'HH24:MI') AS c,
       (ts AT TIME ZONE 'UTC')::date AS d,
       (ts AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS r
  FROM tz_bin.gap GROUP BY h, e, c, d, r;
 h |     e      |   c   |     d      |           r            
---+------------+-------+------------+------------------------
 2 | 1583634600 | 02:30 | 2020-03-08 | 2020-03-07 18:30:00-08
(1 row)

