CALL clickhouse_perform('tuple_map_admin', $$
    CREATE TABLE tuple_map_test.people (
        id UInt32,
        data Tuple(
            name   String,
            age    UInt8,
            gender Enum('male', 'female', 'enby', 'other')
        ),
        sizes Map(String, UInt8)
    ) ENGINE = MergeTree ORDER BY id
$$);
IMPORT FOREIGN SCHEMA tuple_map_test FROM SERVER binary_tuple_map_loopback INTO tupmap_bin;
NOTICE:  pg_clickhouse: ClickHouse <Tuple> type was translated to <TEXT[]> type for column "data"; please create composite type and alter the column if needed
NOTICE:  pg_clickhouse: ClickHouse <Map> type was translated to <TEXT[][]> type for column "sizes"; please create composite type and alter the column if needed
EXECUTE describe('tupmap_bin.people');
