  2 | (Vivian,22,female) | {"(head,29)","(neck,14)","(shoe,9)"}
  3 | (Judith,70,enby)   | {"(head,34)","(shoe,7)"}
  4 | (Bagel,9,other)    | {"(head,10)","(neck,8)"}
(4 rows)

