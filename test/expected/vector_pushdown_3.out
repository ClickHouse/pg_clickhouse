-- Parameters for the vector and the limit.
SET plan_cache_mode = force_generic_plan;
PREPARE knn(vector, int) AS SELECT id FROM vec_items ORDER BY v <-> $1 LIMIT $2;
EXPLAIN (VERBOSE, COSTS OFF) EXECUTE knn('[0.3,-0.2,0.5,0.1]', 3);
                                                               QUERY PLAN                                                               
----------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan on public.vec_items
   Output: id, (v <-> $1)
   Vector Search: L2Distance on v
   Vector Index: none
   Vector Index Not Used: vector similarity indexes require ClickHouse 25.8 or later
   Remote SQL: SELECT id, v FROM vector_pushdown_test.items ORDER BY L2Distance(v, {p1:Array(Float32)}) ASC NULLS LAST LIMIT {p2:Int32}
(6 rows)

EXECUTE knn('[0.3,-0.2,0.5,0.1]', 3);
